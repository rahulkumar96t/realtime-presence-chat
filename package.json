{
  "name": "realtime-presence-chat",
  "version": "0.1.0",
  "description": "WebSocket chat server with rooms, presence, typing indicators, JWT auth, rate limiting, backpressure and pluggable pub/sub for horizontal scaling.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "DEV_TOKENS=true JWT_SECRET=dev-only-secret-change-me-0123456789abcdef tsx src/index.ts",
    "token": "tsx scripts/mint-token.ts"
  },
  "dependencies": {
    "ioredis": "5.11.1",
    "jose": "6.2.14",
    "prom-client": "15.1.3",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/ioredis-mock": "8.2.8",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "eslint": "10.13.0",
    "ioredis-mock": "8.13.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
